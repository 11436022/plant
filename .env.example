GEMINI_API_KEY=你的_Gemini_API_Key
# DB_HOST=host.docker.internal
# DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=你的資料庫密碼
DB_NAME=your_db_name

# JWT 設定
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 站台網址設定
PUBLIC_BASE_URL=http://127.0.0.1:8000
FRONTEND_BASE_URL=http://127.0.0.1:8000
EMAIL_VERIFY_PATH=/user/verify-email
PASSWORD_RESET_PATH=/reset-password

# SMTP 郵件設定
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=mailer@example.com
SMTP_PASSWORD=your-password
SMTP_FROM_EMAIL=mailer@example.com
SMTP_FROM_NAME=Plant API
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# 一次性 token 有效時間
EMAIL_VERIFICATION_EXPIRE_MINUTES=1440
PASSWORD_RESET_EXPIRE_MINUTES=30

### Docker 環境常用 DB_HOST=host.docker.internal
### 本機直接執行時常用 DB_HOST=127.0.0.1
