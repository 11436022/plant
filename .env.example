GEMINI_API_KEY=你的_Gemini_API_Key
# DB_HOST=host.docker.internal
# DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=你的資料庫密碼
DB_NAME=your_db_name

# JWT 設定
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 站台網址設定
WIFI_HOST_IP="你的ip地址"
FRONTEND_BASE_URL=http://127.0.0.1:8000
PUBLIC_BASE_URL=http://127.0.0.1:8000
EMAIL_VERIFY_PATH=/api/v1/auth/user/verify-email
PASSWORD_RESET_PATH=/reset-password

# Webcam 自動警報設定
WEBCAM_MAX_IMAGE_BYTES=8388608
WEBCAM_MIN_IMAGE_WIDTH=320
WEBCAM_MIN_IMAGE_HEIGHT=240
WEBCAM_SAMPLE_INTERVAL_SECONDS=30
WEBCAM_ALERT_CONFIDENCE=0.8
WEBCAM_ALERT_CONSECUTIVE_MATCHES=3
WEBCAM_ALERT_COOLDOWN_SECONDS=900

# SMTP 郵件設定
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME="你的郵件地址"
SMTP_PASSWORD="你的郵件密碼,這是要去Google郵件設定中生成的密碼，不是你的Google帳戶密碼"
SMTP_FROM_EMAIL="你的郵件地址"
SMTP_FROM_NAME=Plant API
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# 一次性 token 有效時間
EMAIL_VERIFICATION_EXPIRE_MINUTES=1440
PASSWORD_RESET_EXPIRE_MINUTES=30

### Docker 環境常用 DB_HOST=host.docker.internal
### 本機直接執行時常用 DB_HOST=127.0.0.1
