<?xml version="1.0" encoding="utf-8"?>
<state-list-animator xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 按下時的狀態 -->
    <item android:state_pressed="true">
        <set>
            <objectAnimator
                android:propertyName="scaleX"
                android:valueTo="1.03"
                android:duration="100" />
            <objectAnimator
                android:propertyName="scaleY"
                android:valueTo="1.03"
                android:duration="100" />
        </set>
    </item>
    <!-- 預設 (放開) 的狀態 -->
    <item android:state_pressed="false">
        <set>
            <objectAnimator
                android:propertyName="scaleX"
                android:valueTo="1.0"
                android:duration="100" />
            <objectAnimator
                android:propertyName="scaleY"
                android:valueTo="1.0"
                android:duration="100" />
        </set>
    </item>
</state-list-animator>