<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/register_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/gradient_background"
    tools:context=".RegisterActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/register_root_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <!-- 🌟 百分比 Guideline：從螢幕高度 10% 處開始，確保不同解析度皆不被遮擋 -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.15" />

        <!-- 1. 頁面大標題 -->
        <TextView
            android:id="@+id/tv_register_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="40dp"
            android:gravity="center"
            android:maxLines="1"
            android:text="註冊帳號"
            android:textColor="#1B5E20"
            android:textSize="52sp"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="52sp"
            app:autoSizeMinTextSize="26sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/guideline_top" />

        <!-- 2. 帳號名稱輸入框 -->
        <EditText
            android:id="@+id/et_reg_username"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_marginHorizontal="40dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_input_field"
            android:hint="設定帳號名稱"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="20dp"
            android:textColor="#333333"
            android:textColorHint="#959595"
            android:textSize="22sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_register_title" />

        <!-- 3. Gmail 地址輸入框 -->
        <EditText
            android:id="@+id/et_reg_gmail"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_marginHorizontal="40dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input_field"
            android:hint="輸入 Gmail 地址"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:paddingHorizontal="20dp"
            android:textColor="#333333"
            android:textColorHint="#959595"
            android:textSize="22sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/et_reg_username" />

        <!-- 4. 設定密碼輸入框 -->
        <EditText
            android:id="@+id/et_reg_password"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_marginHorizontal="40dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input_field"
            android:hint="設定密碼"
            android:inputType="textPassword"
            android:maxLines="1"
            android:paddingHorizontal="20dp"
            android:textColor="#333333"
            android:textColorHint="#959595"
            android:textSize="22sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/et_reg_gmail" />

        <!-- 5. 提交按鈕 -->
        <Button
            android:id="@+id/btn_register_submit"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="40dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="#2E7D32"
            android:gravity="center"
            android:maxLines="1"
            android:text="完成註冊並登錄"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="20sp"
            app:autoSizeMinTextSize="14sp"
            app:autoSizeTextType="uniform"
            app:cornerRadius="28dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/et_reg_password" />

        <!-- 6. 返回登入連結 -->
        <TextView
            android:id="@+id/tv_back_to_login"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="40dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:maxLines="1"
            android:padding="8dp"
            android:text="已有帳號？返回登錄"
            android:textColor="#2E7D32"
            android:textSize="20sp"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="26sp"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_register_submit" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>