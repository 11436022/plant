<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:id="@+id/home_root_layout"
    tools:context=".HomeActivity">

    <ImageView
        android:id="@+id/img_doctor_full"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        android:src="@drawable/doctor"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btn_settings"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="100dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="個人設定"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_settings_logo"
        app:layout_constraintWidth_percent="0.30"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="@+id/img_doctor_full"
        app:layout_constraintTop_toTopOf="@+id/img_doctor_full" />

    <Button
        android:id="@+id/btn_history"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="115dp"
        android:backgroundTint="#2E7D32"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:text="查詢病例"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        app:backgroundTint="@null"
        app:layout_constraintWidth_percent="0.4"
        app:layout_constraintBottom_toBottomOf="@+id/img_doctor_full"
        app:layout_constraintEnd_toEndOf="@+id/img_doctor_full" />
    <Button
        android:id="@+id/btn_diagnose"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="115dp"
        android:backgroundTint="#2E7D32"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:text="診斷植物"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        app:backgroundTint="@null"
        app:layout_constraintWidth_percent="0.4"
        app:layout_constraintBottom_toBottomOf="@+id/img_doctor_full"
        app:layout_constraintStart_toStartOf="@+id/img_doctor_full" />

</androidx.constraintlayout.widget.ConstraintLayout>