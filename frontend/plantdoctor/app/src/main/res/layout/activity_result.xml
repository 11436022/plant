<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/result_root_layout"
    android:background="@drawable/gradient_background">

    <ImageButton
        android:id="@+id/btn_back_home"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="60dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="返回主頁"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#2E7D32" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="診斷報告"
        android:textSize="48sp"
        android:textStyle="bold"
        android:textColor="#1B5E20"
        app:layout_constraintTop_toTopOf="@id/btn_back_home"
        app:layout_constraintBottom_toBottomOf="@id/btn_back_home"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_image_container"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/btn_back_home">

        <ImageView
            android:id="@+id/img_result_plant"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery" />

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/card_advice"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="40dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="30dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cv_image_container"
        android:layout_marginBottom="0dp">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_plant_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="植物：辨識中..."
                    android:textColor="#2E7D32"
                    android:textSize="18sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_status_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="診斷結果"
                    android:textColor="#666666"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_disease_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        tools:text="患病：黑星病 (Black Spot)"
                        android:textColor="#D32F2F"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_feedback_link"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="結果有誤？"
                        android:textColor="#007AFF"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:background="?attr/selectableItemBackground"
                        android:visibility="gone"
                        tools:visibility="visible"/>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:background="#EEEEEE" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="專家處方箋"
                    android:textColor="#2E7D32"
                    android:textStyle="bold"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tv_advice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="6dp"
                    android:text="正在加載建議..."
                    android:textColor="#444444"
                    android:textSize="16sp" />

                <!-- ▼▼▼ 使用者筆記區塊 (開始) ▼▼▼ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="使用者筆記"
                    android:textColor="#666666"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="24dp"/>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <!-- 顯示模式 -->
                    <LinearLayout
                        android:id="@+id/layout_note_display"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/tv_user_note_display"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            tools:text="這是使用者寫下的一些觀察筆記，可能很長也可能很短。"
                            android:textColor="#333333"
                            android:textSize="16sp"
                            android:lineSpacingExtra="4dp"/>

                        <ImageView
                            android:id="@+id/iv_edit_note"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="8dp"
                            android:src="@drawable/ic_edit"
                            android:contentDescription="編輯筆記"
                            app:tint="#888888"
                            android:padding="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"/>
                    </LinearLayout>

                    <!-- 編輯模式 (預設隱藏) -->
                    <LinearLayout
                        android:id="@+id/layout_note_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <EditText
                            android:id="@+id/et_user_note_edit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/edittext_background"
                            android:hint="新增您的觀察筆記..."
                            android:inputType="textMultiLine"
                            android:minLines="3"
                            android:padding="12dp"
                            android:gravity="top"
                            android:textSize="16sp"
                            android:textColor="#333333"/>

                        <Button
                            android:id="@+id/btn_save_note"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="8dp"
                            android:text="儲存筆記"
                            android:backgroundTint="#FF9800"
                            android:textColor="@android:color/white"
                            app:cornerRadius="15dp" />
                    </LinearLayout>
                </FrameLayout>
                <!-- ▲▲▲ 使用者筆記區塊 (結束) ▲▲▲ -->

                <Button
                    android:id="@+id/btn_save_report"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:paddingVertical="14dp"
                    android:backgroundTint="#2E7D32"
                    android:text="儲存至歷史病例"
                    android:textSize="22sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:cornerRadius="15dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="40dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>