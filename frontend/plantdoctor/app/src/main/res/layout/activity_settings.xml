<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_green"
    tools:context=".SettingsActivity">

    <!-- 頂部標題欄 -->
    <RelativeLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_alignParentTop="true"
        android:layout_marginTop="48dp">

        <ImageButton
            android:id="@+id/btn_back_home"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回"
            android:src="@drawable/ic_back"
            app:tint="#1B5E20" />

        <TextView
            android:id="@+id/tv_settings_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="設定"
            android:textColor="#1B5E20"
            android:textSize="28sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- 主要內容滾動區 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_bar"
        android:layout_above="@+id/btn_logout"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center_vertical">

            <!-- 個人資料分區 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="個人資料"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1B5E20"
                android:layout_marginBottom="8dp"/>

            <!-- 使用者名稱卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_settings_card"
                android:padding="16dp"
                android:elevation="4dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="使用者名稱"
                    android:textColor="#666666"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#333333"
                    android:textSize="19sp"
                    tools:text="尚未登錄" />
            </LinearLayout>

            <!-- 電子郵件卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_settings_card"
                android:padding="16dp"
                android:elevation="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="電子郵件"
                    android:textColor="#666666"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_gmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#333333"
                    android:textSize="19sp"
                    tools:text="尚未設定 Email" />
            </LinearLayout>

            <!-- 應用程式設定分區 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="應用程式設定"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1B5E20"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="8dp"/>

            <!-- 更改密碼卡片 -->
            <TextView
                android:id="@+id/tv_forgot_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="更改密碼"
                android:textSize="20sp"
                android:textColor="#333333"
                android:padding="16dp"
                android:background="@drawable/bg_settings_card"
                android:elevation="4dp"
                android:layout_marginBottom="16dp"
                android:drawableStart="@drawable/ic_lock"
                android:drawableEnd="@drawable/ic_arrow_forward"
                android:drawablePadding="16dp"
                android:gravity="center_vertical"
                android:stateListAnimator="@animator/scale_on_press"/>

            <!-- 主題顏色卡片 -->
            <TextView
                android:id="@+id/tv_color_select"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="主題顏色"
                android:textSize="20sp"
                android:textColor="#333333"
                android:padding="16dp"
                android:background="@drawable/bg_settings_card"
                android:elevation="4dp"
                android:layout_marginBottom="16dp"
                android:drawableStart="@drawable/ic_palette"
                android:drawableEnd="@drawable/ic_arrow_forward"
                android:drawablePadding="16dp"
                android:gravity="center_vertical"
                android:stateListAnimator="@animator/scale_on_press"/>

            <!-- 音量設定卡片 -->
            <TextView
                android:id="@+id/tv_volume_mixer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="音量設定"
                android:textSize="20sp"
                android:textColor="#333333"
                android:padding="16dp"
                android:background="@drawable/bg_settings_card"
                android:elevation="4dp"
                android:drawableStart="@drawable/ic_volume"
                android:drawableEnd="@drawable/ic_arrow_forward"
                android:drawablePadding="16dp"
                android:gravity="center_vertical"
                android:stateListAnimator="@animator/scale_on_press"/>

        </LinearLayout>
    </ScrollView>

    <!-- 登出按鈕 -->
    <Button
        android:id="@+id/btn_logout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:backgroundTint="#D32F2F"
        android:text="登出帳號"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        android:stateListAnimator="@animator/scale_on_press" />

</RelativeLayout>