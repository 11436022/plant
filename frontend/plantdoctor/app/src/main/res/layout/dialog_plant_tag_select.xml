<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/dialog_tag_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@id/dialog_tag_btn_close"
                android:text="🌿 儲存至專屬盆栽檔案"
                android:textColor="#1B5E20"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/dialog_tag_btn_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="關閉"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#757575" />
        </RelativeLayout>

        <TextView
            android:id="@+id/dialog_tag_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="為此株植物指定盆栽暱稱，可隔離不同盆栽的時間軸！"
            android:textColor="#78909C"
            android:textSize="12sp" />

        <!-- 快捷標籤列：例如 [陽台1號] [客廳2號] -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layout_quick_tags"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_tag_default_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_selected"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="陽台 1 號"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chip_tag_default_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="客廳 2 號"
                    android:textColor="#2E7D32"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chip_tag_default_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="辦公室"
                    android:textColor="#2E7D32"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- 自訂輸入框 -->
        <EditText
            android:id="@+id/et_plant_tag"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/search_bg"
            android:hint="自訂暱稱（如：露台盆栽 A）..."
            android:paddingHorizontal="14dp"
            android:textColor="#333333"
            android:textColorHint="#90A4AE"
            android:textSize="14sp"
            android:maxLines="1" />

        <!-- 操作按鈕列 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dialog_tag_btn_cancel"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_outline_green"
                android:gravity="center"
                android:text="取消"
                android:textColor="#2E7D32"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dialog_tag_btn_confirm"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1.4"
                android:background="@drawable/bg_button_primary_green"
                android:gravity="center"
                android:text="確認歸檔儲存"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
