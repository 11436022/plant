<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/gradient_background"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_root_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <!-- 🌟 百分比 Guideline：從螢幕 12% 處啟動 -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.12" />

        <!-- 1. 第一字：植 -->
        <TextView
            android:id="@+id/tv_zhi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:text="植"
            android:textColor="#1B5E20"
            android:textSize="60sp"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="60sp"
            app:autoSizeMinTextSize="28sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintEnd_toStartOf="@+id/tv_ye"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/guideline_top" />

        <!-- 2. 第二字：葉 -->
        <TextView
            android:id="@+id/tv_ye"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:text="葉"
            android:textColor="#1B5E20"
            android:textSize="60sp"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="60sp"
            app:autoSizeMinTextSize="28sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintEnd_toStartOf="@+id/tv_shen"
            app:layout_constraintStart_toEndOf="@+id/tv_zhi"
            app:layout_constraintTop_toTopOf="@id/guideline_top" />

        <!-- 3. 第三字：神 -->
        <TextView
            android:id="@+id/tv_shen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:text="神"
            android:textColor="#1B5E20"
            android:textSize="60sp"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="60sp"
            app:autoSizeMinTextSize="28sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintEnd_toStartOf="@+id/tv_yi"
            app:layout_constraintStart_toEndOf="@+id/tv_ye"
            app:layout_constraintTop_toTopOf="@id/guideline_top" />

        <!-- 4. 第四字：醫 -->
        <TextView
            android:id="@+id/tv_yi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:text="醫"
            android:textColor="#1B5E20"
            android:textSize="60sp"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="60sp"
            app:autoSizeMinTextSize="28sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_shen"
            app:layout_constraintTop_toTopOf="@id/guideline_top" />

        <!-- 5. 醫生主圖 -->
        <ImageView
            android:id="@+id/img_doctor_main"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="24dp"
            android:scaleType="centerInside"
            android:src="@drawable/doctor_look"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.60"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_zhi" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>