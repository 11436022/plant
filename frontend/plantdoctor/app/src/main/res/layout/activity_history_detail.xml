<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/history_detail_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageButton
            android:id="@+id/btn_back_home"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="60dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回主頁"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#2E7D32" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="48dp"
            android:gravity="center"
            android:text="病例詳情"
            android:textColor="#1B5E20"
            android:textSize="44sp"
            android:textStyle="bold"
            app:autoSizeMinTextSize="24sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cv_image_container"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/btn_back_home">

            <ImageView
                android:id="@+id/img_result_plant"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery" />
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/card_advice"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="30dp"
        app:cardElevation="16dp"
        app:behavior_hideable="false"
        app:behavior_peekHeight="480dp"
        app:behavior_fitToContents="false"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <View
                android:id="@+id/view_drag_handle"
                android:layout_width="40dp"
                android:layout_height="5dp"
                android:layout_marginTop="12dp"
                android:background="#D0D0D0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:padding="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/view_drag_handle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_plant_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="植物：辨識中..."
                        android:textColor="#2E7D32"
                        android:textSize="18sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_status_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="診斷結果"
                        android:textColor="#666666"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tv_disease_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            tools:text="診斷：黑星病"
                            android:textColor="#D32F2F"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="16sp"/>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="16dp"
                        android:background="#EEEEEE" />

                    <!-- 🌟 核心升級：超越 GPT 的「連續生長與康復時間軸」區塊 -->
                    <LinearLayout
                        android:id="@+id/layout_recovery_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="20dp">

                        <TextView
                            android:id="@+id/tv_timeline_header_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌱 單株專屬康復時間軸與生長監控"
                            android:textColor="#2E7D32"
                            android:textStyle="bold"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="系統自動按時序串聯同一株植物的連續追蹤紀錄"
                            android:textColor="#78909C"
                            android:textSize="12sp" />

                        <!-- 趨勢總評卡片 -->
                        <LinearLayout
                            android:id="@+id/card_trend_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_card_treatment_highlight"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:id="@+id/tv_trend_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="🌱 專屬時序建立中"
                                android:textColor="#1B5E20"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_trend_desc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:lineSpacingExtra="2dp"
                                android:text="載入病程時間軸中..."
                                android:textColor="#2E7D32"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- 🌟 Before vs After 關鍵照片對照卡 -->
                        <LinearLayout
                            android:id="@+id/layout_before_after"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tv_compare_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🔍 歷程影像對比 (Before vs After)"
                                android:textColor="#37474F"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal">

                                <!-- Before (初期) -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center_horizontal"
                                    android:orientation="vertical">

                                    <androidx.cardview.widget.CardView
                                        android:id="@+id/cv_before_img"
                                        android:layout_width="match_parent"
                                        android:layout_height="120dp"
                                        app:cardCornerRadius="12dp"
                                        app:cardElevation="2dp">

                                        <ImageView
                                            android:id="@+id/img_before"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:scaleType="centerCrop"
                                            android:src="@android:drawable/ic_menu_gallery" />
                                    </androidx.cardview.widget.CardView>

                                    <TextView
                                        android:id="@+id/tv_before_label"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="初期發病"
                                        android:textColor="#C62828"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tv_before_date"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="2026/10/07"
                                        android:textColor="#78909C"
                                        android:textSize="11sp" />
                                </LinearLayout>

                                <View
                                    android:layout_width="12dp"
                                    android:layout_height="match_parent" />

                                <!-- After (最新現況) -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center_horizontal"
                                    android:orientation="vertical">

                                    <androidx.cardview.widget.CardView
                                        android:id="@+id/cv_after_img"
                                        android:layout_width="match_parent"
                                        android:layout_height="120dp"
                                        app:cardCornerRadius="12dp"
                                        app:cardElevation="2dp">

                                        <ImageView
                                            android:id="@+id/img_after"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:scaleType="centerCrop"
                                            android:src="@android:drawable/ic_menu_gallery" />
                                    </androidx.cardview.widget.CardView>

                                    <TextView
                                        android:id="@+id/tv_after_label"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="最新現況"
                                        android:textColor="#2E7D32"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tv_after_date"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="2026/10/20"
                                        android:textColor="#78909C"
                                        android:textSize="11sp" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- 垂直時間軸容器 -->
                        <LinearLayout
                            android:id="@+id/container_timeline_nodes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:background="#EEEEEE" />

                    <!-- 🌟 處方箋區塊標題與「一鍵噴藥/照護打卡」按鈕 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="專家處方箋"
                            android:textColor="#2E7D32"
                            android:textStyle="bold"
                            android:textSize="18sp" />

                        <!-- 一鍵打卡按鈕 -->
                        <TextView
                            android:id="@+id/btn_care_checkin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_healthy"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"
                            android:text="🌿 記錄今日已噴藥"
                            android:textColor="#2E7D32"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 卡片 1：病況狀態與徵候摘要 -->
                    <LinearLayout
                        android:id="@+id/card_prescription_symptom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_card_meta_info"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔍 病況特徵分析"
                            android:textColor="#37474F"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_detail_symptom"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="3dp"
                            android:text="載入病徵狀態中..."
                            android:textColor="#455A64"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- 卡片 2：居家安心用藥指南與生活化泡法 (綠色重點卡) -->
                    <LinearLayout
                        android:id="@+id/card_prescription_remedy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_card_treatment_highlight"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="🌿 居家安心推薦資材與配方"
                                android:textColor="#1B5E20"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/btn_open_remedy_catalog"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="官方用藥寶典 ➜"
                                android:textColor="#2E7D32"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_detail_treatment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:lineSpacingExtra="4dp"
                            android:text="載入處方指南中..."
                            android:textColor="#1B5E20"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- 保留原有 tv_advice ID 保持向後相容性，但預設收納隱藏 -->
                    <TextView
                        android:id="@+id/tv_advice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="10dp"
                        android:background="#EEEEEE" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📝 照護筆記與觀察"
                        android:textColor="#2E7D32"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:id="@+id/layout_note_display"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">
                        <TextView
                            android:id="@+id/tv_user_note_display"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="讀取筆記中..."
                            android:textColor="#333333"
                            android:textSize="16sp" />
                        <ImageView
                            android:id="@+id/iv_edit_note"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_edit"
                            app:tint="#2E7D32"
                            android:padding="2dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_note_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginBottom="16dp">
                        <EditText
                            android:id="@+id/et_user_note_edit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="輸入筆記..."
                            android:textColor="#333333"
                            android:textSize="16sp"/>
                        <Button
                            android:id="@+id/btn_save_note"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:text="儲存筆記"
                            android:backgroundTint="#2E7D32" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_save_report"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:paddingVertical="14dp"
                        android:backgroundTint="#ED1930"
                        android:text="刪除病例"
                        android:textSize="22sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        app:cornerRadius="15dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="160dp" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_pip_container"
        android:layout_width="140dp"
        android:layout_height="90dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="100dp"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="24dp">
        <ImageView
            android:id="@+id/img_pip_plant"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery" />
    </androidx.cardview.widget.CardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
