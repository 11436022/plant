<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:id="@+id/webcam_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".WebcamActivity">

    <!-- 1. 相機即時預覽畫面 -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 🌟 自訂繪圖層（繪製多植物選取框與名稱標籤） -->
    <com.example.plantdoctor.InteractiveBoxView
        android:id="@+id/overlayCanvas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. 頂部控制工具列 (模式切換、省電、新增方框) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 模式切換鈕 -->
        <RadioGroup
            android:id="@+id/rgMode"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:checkedButton="@id/rbSingleMode"
            android:orientation="horizontal"
            android:padding="2dp">

            <RadioButton
                android:id="@+id/rbSingleMode"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:button="@null"
                android:gravity="center"
                android:text="單植物"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rbMultiMode"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:button="@null"
                android:gravity="center"
                android:text="多植物(方案B)"
                android:textSize="13sp"
                android:textStyle="bold" />
        </RadioGroup>

        <!-- 新增方框按鈕 (僅多植物模式顯示) -->
        <Button
            android:id="@+id/btnAddRegion"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="12dp"
            android:text="+ 新增區域"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- 手動省電按鈕 -->
        <ImageButton
            android:id="@+id/btnPowerSave"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="進入省電模式"
            android:src="@android:drawable/ic_menu_compass" />
    </LinearLayout>

    <!-- 3. 下方半透明分析與控制懸浮面板 -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- 狀態與資訊列 -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="狀態：已暫停"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDiagnosis"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="最新診斷：等待拍攝..."
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvStreak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="本次偵測次數：0"
            android:textSize="12sp" />

        <View
            android:id="@+id/dividerLine"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="#33FFFFFF" />

        <!-- 🌟【單植物控制區域】：拖動條 + 秒數輸入框 -->
        <LinearLayout
            android:id="@+id/layoutSingleControl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="visible">

            <TextView
                android:id="@+id/tvSingleIntervalTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="採樣間隔："
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/sbSingleInterval"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="600"
                android:min="30"
                android:progress="120" />

            <EditText
                android:id="@+id/etSingleInterval"
                android:layout_width="55dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="4"
                android:text="120"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvSingleIntervalUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="秒"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 🌟【多植物控制區域】：列表清單 + 旁邊放置組別選擇按鈕 -->
        <LinearLayout
            android:id="@+id/layoutMultiControl"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- 標題欄：左邊標題，右邊點擊選組別按鈕 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tvMultiListTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="監控區域排程列表"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnSelectSession"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@android:drawable/editbox_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="[ 陽台花草組 ▼ ]"
                    android:textColor="#1976D2"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMultiRegions"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="vertical" />
        </LinearLayout>

        <Button
            android:id="@+id/btnToggleMonitor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="開始即時監控" />
    </LinearLayout>

    <!-- 4. 全黑省電覆蓋層 (確保 OLED 省電) -->
    <FrameLayout
        android:id="@+id/layoutPowerSaveOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FF000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🌙 省電監控中...\n(點擊螢幕任意處喚醒)"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>