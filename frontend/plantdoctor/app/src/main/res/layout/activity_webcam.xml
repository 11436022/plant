<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:id="@+id/webcam_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".WebcamActivity">

    <!-- 1. 相機即時預覽畫面 -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 🌟 自訂繪圖層（繪製多植物選取框與名稱標籤） -->
    <com.example.plantdoctor.InteractiveBoxView
        android:id="@+id/overlayCanvas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. 頂部控制工具列 (返回按鈕、模式切換、省電、新增區域) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 🌟 返回主頁按鈕 -->
        <ImageButton
            android:id="@+id/btn_back_home"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回主頁"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"
            app:tint="@android:color/white" />

        <!-- 模式切換 RadioGroup -->
        <RadioGroup
            android:id="@+id/rgMode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checkedButton="@id/rbSingleMode"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbSingleMode"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:button="@null"
                android:gravity="center"
                android:text="單植物"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rbMultiMode"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:button="@null"
                android:gravity="center"
                android:text="多植物分區"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </RadioGroup>

        <!-- 新增區域按鈕 (多植物模式) -->
        <Button
            android:id="@+id/btnAddRegion"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:paddingHorizontal="10dp"
            android:text="+ 新增區域"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- 省電按鈕 -->
        <ImageButton
            android:id="@+id/btnPowerSave"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="進入省電模式"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_compass" />
    </LinearLayout>

    <!-- 3. 下方懸浮診斷控制面板 -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- 狀態資訊 -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="狀態：已暫停"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDiagnosis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="最新診斷：等待拍攝..."
            android:textColor="#E0E0E0"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvStreak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="本次偵測次數：0 次"
            android:textColor="#B0BEC5"
            android:textSize="13sp" />

        <View
            android:id="@+id/dividerLine"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="#40FFFFFF" />

        <!-- 🌟【單植物控制區域】 -->
        <LinearLayout
            android:id="@+id/layoutSingleControl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="visible">

            <TextView
                android:id="@+id/tvSingleIntervalTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="採樣間隔："
                android:textColor="@android:color/white"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/sbSingleInterval"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="600"
                android:min="30"
                android:progress="120" />

            <EditText
                android:id="@+id/etSingleInterval"
                android:layout_width="55dp"
                android:layout_height="36dp"
                android:background="@android:drawable/editbox_background"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="4"
                android:text="120"
                android:textColor="#000000"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvSingleIntervalUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="秒"
                android:textColor="@android:color/white"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 🌟【多植物控制區域】 -->
        <LinearLayout
            android:id="@+id/layoutMultiControl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- 標題與選組別按鈕 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tvMultiListTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="區域排程列表"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- 🌟 組別切換晶片按鈕 -->
                <TextView
                    android:id="@+id/btnSelectSession"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="陽台花草組 ▼"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:textColor="#2E7D32" />

            </LinearLayout>

            <!-- 列表高動態約束：最高 130dp，支援小螢幕自動滾動 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMultiRegions"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:scrollbars="vertical" />
        </LinearLayout>

        <!-- 開始/停止監控按鈕 -->
        <Button
            android:id="@+id/btnToggleMonitor"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="開始即時監控"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 4. 省電全黑覆蓋層 -->
    <FrameLayout
        android:id="@+id/layoutPowerSaveOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FF000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🌙 省電監控中...\n(點擊螢幕任意處喚醒)"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>