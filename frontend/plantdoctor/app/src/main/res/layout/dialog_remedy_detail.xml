<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp"
    app:cardBackgroundColor="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="600dp"
        android:fadeScrollbars="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 頂部列：商品標題 + 右上角關閉按鈕 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/dialog_remedy_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@id/dialog_btn_close"
                    android:layout_marginEnd="12dp"
                    android:text="原礦家農法液劑-3"
                    android:textColor="#1B5E20"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="2dp" />

                <ImageButton
                    android:id="@+id/dialog_btn_close"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="關閉"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#757575" />
            </RelativeLayout>

            <!-- 官方登記字號與廠商小字 -->
            <TextView
                android:id="@+id/dialog_remedy_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="植保製字第00636號 · 鵬景國際興業 (臺中市)"
                android:textColor="#78909C"
                android:textSize="12sp" />

            <!-- 膠囊標籤列 (Chips) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/dialog_badge_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_efficacy"
                    android:text="🛡️ 防病除蟲"
                    android:textColor="#1565C0"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />

                <TextView
                    android:id="@+id/dialog_badge_pet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_safe"
                    android:text="🐾 寵物友善"
                    android:textColor="#0277BD"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />

                <TextView
                    android:id="@+id/dialog_badge_indoor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_healthy"
                    android:text="🌱 室內安全"
                    android:textColor="#2E7D32"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>

            <!-- 亮點區塊 1：專剋功效與主治 (綠色高亮卡片) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_treatment_highlight"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎯 核心功效與主治病蟲"
                    android:textColor="#2E7D32"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dialog_tv_efficacy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="白粉病、線蟲、炭疽病"
                    android:textColor="#1B5E20"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="#C5E1A5" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧪 審定有效主成分"
                    android:textColor="#33691E"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dialog_tv_ingredients"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="甲殼素、醋"
                    android:textColor="#2E7D32"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 亮點區塊 2：生活化居家調配口訣 (藍色溫馨指南卡) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_dilution_tip"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧴 居家調配口訣（免用量杯）"
                    android:textColor="#0277BD"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dialog_tv_dilution"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="3dp"
                    android:text="拿 1 瓶 600ml 寶特瓶裝水，倒入「半瓶蓋」藥劑搖勻即可均勻噴灑於葉背與莖部。"
                    android:textColor="#01579B"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 亮點區塊 3：環境與安全詳細說明 (精緻灰卡) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_meta_info"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/dialog_tv_safety_indoor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• 居家室內：純天然/物理機制資材，極適合居家與辦公室密閉環境使用"
                    android:textColor="#455A64"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:id="@+id/dialog_tv_safety_pet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="• 寵物安全：食品級或天然礦物成分，犬貓寵物友善，室內可安全使用"
                    android:textColor="#455A64"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <!-- 底部主要操作按鈕雙列 (CTA Buttons) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/dialog_btn_license"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_outline_green"
                    android:gravity="center"
                    android:text="🔍 審定證件"
                    android:textColor="#2E7D32"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dialog_btn_buy"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1.3"
                    android:background="@drawable/bg_button_primary_green"
                    android:gravity="center"
                    android:text="🛒 前往採購/比價"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.cardview.widget.CardView>
