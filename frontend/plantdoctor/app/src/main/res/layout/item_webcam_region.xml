<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_region_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

    <!-- 植物標籤/區塊名稱 -->
    <EditText
        android:id="@+id/etRegionName"
        android:layout_width="80dp"
        android:layout_height="32dp"
        android:hint="植物A"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:paddingHorizontal="4dp"
        android:textSize="12sp" />

    <!-- 拖動條 -->
    <SeekBar
        android:id="@+id/sbRegionInterval"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:max="600"
        android:min="10"
        android:progress="120" />

    <!-- 時間輸入框 -->
    <EditText
        android:id="@+id/etRegionInterval"
        android:layout_width="45dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:inputType="number"
        android:maxLength="4"
        android:text="120"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvRegionUnit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:text="秒"
        android:textSize="11sp" />

    <!-- 刪除該方框按鈕 -->
    <ImageButton
        android:id="@+id/btnDeleteRegion"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="刪除區域"
        android:src="@android:drawable/ic_delete" />
</LinearLayout>