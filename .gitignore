# Android
/frontend/plantdoctor/local.properties

.env
__pycache__/
.vscode/
*.pyc
venv/
.idea/

# 模型權重檔（超過 GitHub 100MB 限制，請於 GitHub Releases 下載）
*.pth
*.pt
!static/visual_memory_cache.pt

# 排除上傳的測試暫存檔
static/tmp/*
!static/tmp/.gitkeep

# 忽略 Office 暫存檔與本地參考複本
~$*
documents/* (2).docx

# 臨時測試與暫存腳本
scratch/
test_ext_*/
documents/test*.docx
documents/*.bak*
*.bak

# 本地暫存與產出物
artifacts/
dataset/
Plant_Doctor*.pdf
documents/Plant_Doctor*.pdf
documents/*git最新版*.docx
documents/*組員最新版*.docx
documents/*本地修改留存*.docx

*.apk

