# Android
/frontend/plantdoctor/local.properties

.env
__pycache__/
.vscode/
*.pyc
venv/
.idea/

# 模型權重檔（超過 GitHub 100MB 限制，請於 GitHub Releases 下載）
*.pth
*.pt

# 排除上傳的測試圖片與暫存檔
static/tmp/*
!static/tmp/.gitkeep

# 忽略 uploads 資料夾中的所有內容
static/uploads/*

# 但保留 .gitkeep，以便 Git 追蹤這個空目錄
!static/uploads/.gitkeep

# 忽略 Office 暫存檔
~$*